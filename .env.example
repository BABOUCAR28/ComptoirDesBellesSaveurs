# Copier en .env (jamais commité) puis adapter.
NODE_ENV=production
PORT=3000
SITE_URL=https://votre-domaine.sn
# Identifiants admin, utilisés uniquement à la 1re exécution (mot de passe >= 10 caractères).
# S'ils sont absents, un mot de passe est généré et affiché une fois dans la console.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Dossier de la base SQLite et des photos (à sauvegarder)
DATA_DIR=./data
# 1 si le site est derrière un proxy HTTPS (Nginx, Caddy…)
TRUST_PROXY=1
# Optionnel : notification à chaque demande reçue (POST texte), ex. un sujet ntfy.sh privé
NOTIFY_URL=
